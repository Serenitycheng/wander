# Map display and route services
NEXT_PUBLIC_AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=

# DeepSeek natural-language constraint parsing
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Manyou web discovery uses the Anthropic-compatible Messages + native web search.
# Uses the same server-side DEEPSEEK_API_KEY; these optional overrides affect only exploration.
# EXPLORATION_DEEPSEEK_MODEL=deepseek-flash
# EXPLORATION_DEEPSEEK_BASE_URL=https://api.deepseek.com

# Vercel-managed Neon Postgres (configured during publishing)
DATABASE_URL=

# Session signing secret (generate a long random value)
AUTH_SECRET=
NEXT_PUBLIC_REQUIRE_AUTH=true

# Initial private accounts. Store scrypt output as saltHex:hashHex, never plaintext.
SERENITY_PASSWORD_SCRYPT=
ZZZ_PASSWORD_SCRYPT=
